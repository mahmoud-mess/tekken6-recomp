new file mode 100644
index 0000000..aaac8ae
--- /dev/null
+++ b/tests/unit/codegen/function_scanner_test.cpp
@@ -0,0 +1,121 @@
+/**
+ * @file        codegen/function_scanner_test.cpp
+ * @brief       Tests for conservative jump table detection
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <vector>
+
+#include <rex/codegen/binary_view.h>
+#include <rex/codegen/code_region.h>
+#include <rex/codegen/config.h>
+#include <rex/codegen/function_scanner.h>
+#include <rex/codegen/test_support.h>
+
+#include "codegen/decoded_binary.h"
+
+namespace rex::codegen {
+namespace {
+
+void StoreBigEndianWord(std::vector<uint8_t>& data, uint32_t offset, uint32_t value) {
+  data[offset + 0] = static_cast<uint8_t>(value >> 24);
+  data[offset + 1] = static_cast<uint8_t>(value >> 16);
+  data[offset + 2] = static_cast<uint8_t>(value >> 8);
+  data[offset + 3] = static_cast<uint8_t>(value);
+}
+
+}  // namespace
+}  // namespace rex::codegen
+
+TEST_CASE("Jump table with backward function targets is rejected as incomplete",
+          "[codegen][function_scanner]") {
+  using namespace rex::codegen;
+
+  constexpr uint32_t kBase = 0;
+  constexpr uint32_t kFunctionStart = 0x40;
+  constexpr uint32_t kBranchAddress = 0x68;
+  constexpr uint32_t kTableAddress = 0xA0;
+  constexpr size_t kImageSize = 0xC0;
+
+  // The sequence loads a CTR target through an absolute indexed word table.
+  // Its first two entries target the current function; the third dispatches
+  // to an earlier function. The old scanner incorrectly returned the first
+  // two entries as a complete switch table.
+  std::vector<uint8_t> image(kImageSize);
+  for (uint32_t offset = 0; offset < kImageSize; offset += 4) {
+    StoreBigEndianWord(image, offset, 0x60000000);  // ori r0,r0,0 (nop)
+  }
+
+  constexpr uint32_t kInstructions[] = {
+      0x81430020,  // lwz    r10,32(r3)
+      0x3D200000,  // lis    r9,0
+      0x81640004,  // lwz    r11,4(r4)
+      0x390900A0,  // addi   r8,r9,0xA0
+      0x814A0000,  // lwz    r10,0(r10)
+      0x7C8A5A14,  // add    r4,r10,r11
+      0x7CEA582E,  // lwzx   r7,r10,r11
+      0x54E516BA,  // rlwinm r5,r7,2,26,29
+      0x7D65402E,  // lwzx   r11,r5,r8
+      0x7D6903A6,  // mtctr  r11
+      0x4E800420,  // bctr
+  };
+  for (size_t i = 0; i < std::size(kInstructions); ++i) {
+    StoreBigEndianWord(image, kFunctionStart + static_cast<uint32_t>(i * 4),
+                       kInstructions[i]);
+  }
+
+  StoreBigEndianWord(image, kTableAddress + 0, kFunctionStart);
+  StoreBigEndianWord(image, kTableAddress + 4, kFunctionStart);
+  StoreBigEndianWord(image, kTableAddress + 8, 0x10);
+
+  TestModule module;
+  module.Load(kBase, image.data(), image.size());
+  auto binary = BinaryView::fromModule(module);
+  DecodedBinary decoded(binary);
+  decoded.decode();
+
+  const CodeRegion region{kBase, static_cast<uint32_t>(image.size())};
+  const auto result = detectJumpTable(decoded, kBranchAddress, region, kFunctionStart,
+                                      static_cast<uint32_t>(image.size()));
+
+  CHECK_FALSE(result.has_value());
+}
+
+TEST_CASE("Manual jump table preserves a masked selector", "[codegen][config]") {
+  using namespace rex::codegen;
+
+  const auto configPath =
+      std::filesystem::temp_directory_path() / "rexglue_masked_switch_test.toml";
+  {
+    std::ofstream configFile(configPath, std::ios::binary);
+    REQUIRE(configFile.good());
+    configFile << R"(
+file_path = "fixture.xex"
+out_directory_path = "generated"
+
+[[switch_tables]]
+address = 0x8256D5E0
+register = 7
+selector_mask = 0xF
+labels = [0x8256D5B8, 0x8256D5B8, 0, 0]
+)";
+  }
+
+  RecompilerConfig config;
+  const bool loaded = config.Load(configPath.string());
+  std::error_code ec;
+  std::filesystem::remove(configPath, ec);
+
+  REQUIRE(loaded);
+  const auto it = config.switchTables.find(0x8256D5E0);
+  REQUIRE(it != config.switchTables.end());
+  CHECK(it->second.indexRegister == 7);
+  CHECK(it->second.selectorMask == 0xF);
+  REQUIRE(it->second.targets.size() == 4);
+  CHECK(it->second.targets[0] == 0x8256D5B8);
+}
