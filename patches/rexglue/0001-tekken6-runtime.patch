+  // is the T-shaped (or somewhat H-shaped) metal beams in the beginning of the
+  // first mission), however the contents don't say anything about the channel
+  // order.
+  uint4_xe row =
+      (((halfblocks.xxyy >> uint2_xe(3u, 11u).xyxy) & 1u) << 4u) |
+      (((halfblocks.xxyy >> uint2_xe(7u, 15u).xyxy) & 1u) << 20u) |
+      (((halfblocks.xxyy >> uint2_xe(2u, 10u).xyxy) & 1u) << 8u) |
+      (((halfblocks.xxyy >> uint2_xe(6u, 14u).xyxy) & 1u) << 24u) |
+      (((halfblocks.xxyy >> uint2_xe(1u, 9u).xyxy) & 1u) << 12u) |
+      (((halfblocks.xxyy >> uint2_xe(5u, 13u).xyxy) & 1u) << 28u) |
+      ((halfblocks.xxyy >> uint2_xe(0u, 8u).xyxy) & 1u) |
