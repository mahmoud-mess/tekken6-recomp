+const char* ObjectTypeName(XObject::Type type) {
+  switch (type) {
+    case XObject::Type::Event: return "event";
+    case XObject::Type::File: return "file";
+    case XObject::Type::IOCompletion: return "iocompletion";
+    case XObject::Type::Module: return "module";
+    case XObject::Type::Mutant: return "mutant";
+    case XObject::Type::NotifyListener: return "notifylistener";
+    case XObject::Type::Semaphore: return "semaphore";
+    case XObject::Type::Session: return "session";
+    case XObject::Type::Socket: return "socket";
+    case XObject::Type::SymbolicLink: return "symlink";
+    case XObject::Type::Thread: return "thread";
+    case XObject::Type::Timer: return "timer";
+    default: return "other";
+  }
+}
+
+std::atomic<bool> g_dump_watchdog_started{false};
+
+}  // namespace
+
+// Prints every waitable kernel object with its host state and what each guest
+// thread is blocked on. Triggered by creating the file named in the
+// REX_DEBUG_DUMP_TRIGGER environment variable while the game runs.
+void KernelState::DumpKernelObjects() {
+  auto objects = object_table_.GetAllObjects();
+  std::string out = fmt::format("==== kernel object dump: {} objects\n", objects.size());
+  for (auto& object : objects) {
+    auto type = object->type();
+    if (type == XObject::Type::Thread) {
+      auto* thread = static_cast<XThread*>(object.get());
+      out += fmt::format("thread {:#x} tid={:#x} running={} name='{}' waiting_on={:#x} {:#x} {:#x}\n",
+                         object->handle(), thread->thread_id(), thread->is_running(),
+                         object->name(), thread->debug_wait(0), thread->debug_wait(1),
+                         thread->debug_wait(2));
+      continue;
+    }
+    if (type != XObject::Type::Event && type != XObject::Type::Mutant &&
+        type != XObject::Type::Semaphore && type != XObject::Type::Timer) {
+      continue;
+    }
+    out += fmt::format("{} {:#x} name='{}' {}\n", ObjectTypeName(type), object->handle(),
+                       object->name(), object->DebugWaitState());
+  }
+  out += "==== end of dump\n";
+  fputs(out.c_str(), stderr);
+  fflush(stderr);
+  REXSYS_WARN("{}", out);
+}
