+
+void DeferredCommandBuffer::WriteUploadSlot() {
+  auto& args =
+      *reinterpret_cast<ArgsUploadSlot*>(WriteCommand(Command::kUploadSlot, sizeof(ArgsUploadSlot)));
+  args.slot = uint32_t(upload_slots_.size());
+  upload_slots_.emplace_back();
+  pass_open_ = true;
+  ++pass_serial_;
