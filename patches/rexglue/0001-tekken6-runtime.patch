+
+  #define byte_buffer_align8_load8_xe(name, byte_address) \
+      (*reinterpret_cast<const device uint2_xe*>(&(name)[(byte_address)]))
+
+  #define byte_buffer_align16_load16_xe(name, byte_address) \
